struct mhfpac_header {
    signature sig [[name("File header signature")]];
    ptr_table ptrs [[name("Top level pointer table")]];
};

mhfpac_header header @ 0x0 [[name("mhfpac Header")]];

str __header_fail_msg = "File header does not match expected mhfpac header";

std::assert_warn(header.sig.header1 == 0x1A636170, __header_fail_msg);
std::assert_warn(header.sig.header2 == 0x0000000A, __header_fail_msg);
